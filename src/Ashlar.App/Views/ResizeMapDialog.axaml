<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ashlar.App.ViewModels"
        x:Class="Ashlar.App.Views.ResizeMapDialog"
        x:DataType="vm:ResizeMapDialogViewModel"
        Title="Resize map"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="12" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Width:" VerticalAlignment="Center" />
            <NumericUpDown Name="WidthBox" Value="{Binding Width}" Minimum="1" Maximum="1000" Width="120" />
            <TextBlock Text="Height:" VerticalAlignment="Center" />
            <NumericUpDown Name="HeightBox" Value="{Binding Height}" Minimum="1" Maximum="1000" Width="120" />
        </StackPanel>
        <TextBlock Classes="secondary" Text="The top-left cell stays in place; cells are added or cut off on the right and bottom." TextWrapping="Wrap" />
        <TextBlock Name="ErrorText" Classes="secondary" Text="{Binding Error}" MinHeight="18" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="OkButton" Content="Resize" IsDefault="True" Click="OnOkClick" IsEnabled="{Binding IsValid}" MinWidth="80" />
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
