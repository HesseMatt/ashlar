<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ashlar.App.ViewModels"
        x:Class="Ashlar.App.Views.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="Export XML"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="OkButton" Content="OK" IsDefault="True" Click="OnOkClick" MinWidth="80" />
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Classes="secondary" Text="Texture path" FontWeight="SemiBold" />
            <TextBox Name="TexturePathBox" Text="{Binding TexturePath, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="4" Margin="0,12,0,0">
            <TextBlock Classes="secondary" Text="Preview" FontWeight="SemiBold" />
            <TextBox Name="PreviewBox" Text="{Binding PreviewXml}" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" Height="270"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </DockPanel>
</Window>
