<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ashlar.App.ViewModels"
             xmlns:controls="using:Ashlar.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="600"
             x:Class="Ashlar.App.Views.TilesetEditorView"
             x:DataType="vm:TilesetEditorViewModel">

    <DockPanel>
        <Border Classes="panel" DockPanel.Dock="Right" Width="220" Margin="0,6,6,6" ClipToBounds="True">
            <DockPanel>
                <Border Classes="panelHeader" DockPanel.Dock="Top">
                    <TextBlock Classes="panelHeaderText" Text="INSPECTOR" />
                </Border>
                <StackPanel Spacing="16" Margin="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" Text="Tile ID" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedTileId}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" Text="Group" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding GroupNames}" IsEditable="True" Text="{Binding GroupNameInput, Mode=TwoWay}"
                                  IsEnabled="{Binding HasSelectedTiles}" HorizontalAlignment="Stretch"
                                  KeyDown="OnGroupNameInputKeyDown" SelectionChanged="OnGroupNameSelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Classes="canvas" Margin="6">
            <ScrollViewer x:Name="TileCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- The padding is the overscroll margin around the zoomed tileset (set from code,
                     since it depends on the viewport size). The transparent background makes the
                     padding hit-testable, so panning can start there too. -->
                <Border x:Name="TileCanvasPadding" Background="Transparent" IsVisible="{Binding HasImage}"
                        Focusable="True" PointerPressed="OnTileCanvasPointerPressed" PointerMoved="OnTileCanvasPointerMoved"
                        PointerReleased="OnTileCanvasPointerReleased" PointerCaptureLost="OnTileCanvasPointerCaptureLost"
                        PointerWheelChanged="OnTileCanvasPointerWheelChanged">
                    <Panel Width="{Binding ScaledImageWidth}" Height="{Binding ScaledImageHeight}">
                        <!-- Left/Top alignment is load-bearing: a Panel centers a child that has an
                             explicit Width/Height, which would place this panel's unscaled layout slot
                             in the middle of the zoomed wrapper above. The ScaleTransform then scales
                             out from there instead of from the wrapper's origin, pushing the right and
                             bottom of the image outside the scrollable extent, where it can't be
                             reached by panning. -->
                        <Panel x:Name="TileCanvasContent" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                            <Panel.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                            </Panel.RenderTransform>
                            <controls:TransparencyCheckerboard ImageWidth="{Binding ImageWidth}" ImageHeight="{Binding ImageHeight}"
                                                               TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}" />
                            <Image x:Name="TilesetImage" Source="{Binding PreviewBitmap}" Stretch="None" />
                            <controls:TileGridOverlay x:Name="TileOverlay" ImageWidth="{Binding ImageWidth}" ImageHeight="{Binding ImageHeight}"
                                                       TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}"
                                                       SelectedTiles="{Binding SelectedTiles}"
                                                       SelectionRectangle="{Binding SelectionRectangle}"
                                                       MoveOffset="{Binding MoveOffset}" Image="{Binding PreviewBitmap}"
                                                       ZoomLevel="{Binding ZoomLevel}" ShowPixelGrid="{Binding ShowPixelGrid}" />
                        </Panel>
                    </Panel>
                </Border>
            </ScrollViewer>
        </Border>
    </DockPanel>

</UserControl>
