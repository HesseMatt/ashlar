<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ashlar.App.ViewModels"
             x:Class="Ashlar.App.Views.MapToolBar"
             x:DataType="vm:MapEditorViewModel">

    <UserControl.Resources>
        <!-- Icon path is from Lucide (https://lucide.dev), 24x24 viewBox, stroked. See NOTICE. -->
        <StreamGeometry x:Key="RectangleSelectIcon">M12.034 12.681a.498.498 0 0 1 .647-.647l9 3.5a.5.5 0 0 1-.033.943l-3.444 1.068a1 1 0 0 0-.66.66l-1.067 3.443a.5.5 0 0 1-.943.033z M5 3a2 2 0 0 0-2 2 M19 3a2 2 0 0 1 2 2 M5 21a2 2 0 0 1-2-2 M9 3h1 M9 21h2 M14 3h1 M3 9v1 M21 9v2 M3 14v1</StreamGeometry>
        <StreamGeometry x:Key="MoveIcon">M12 2v20 m15 19-3 3-3-3 m19 9 3 3-3 3 M2 12h20 m5 9-3 3 3 3 m9 5 3-3 3 3</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10 11v6 M14 11v6</StreamGeometry>
        <StreamGeometry x:Key="DrawIcon">M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z m15 5 4 4</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.panel Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </UserControl.Styles>

    <Border Classes="panel" Margin="6,6,0,6" Padding="4" VerticalAlignment="Top">
        <StackPanel Spacing="4">
            <ToggleButton Classes="tool" x:Name="MapRectangleSelectButton" IsChecked="{Binding IsRectangleToolActive}"
                          ToolTip.Tip="Rectangle select">
                <Path Data="{StaticResource RectangleSelectIcon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
            </ToggleButton>
            <ToggleButton Classes="tool" x:Name="MapMoveButton" IsChecked="{Binding IsMoveToolActive}"
                          ToolTip.Tip="Move">
                <Path Data="{StaticResource MoveIcon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
            </ToggleButton>
            <ToggleButton Classes="tool" x:Name="MapDrawButton" IsChecked="{Binding IsDrawToolActive}"
                          ToolTip.Tip="Draw">
                <Path Data="{StaticResource DrawIcon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
            </ToggleButton>
            <Button Classes="tool" x:Name="MapDeleteButton" Click="OnDeleteSelectedCellsClick" IsEnabled="{Binding HasSelectedCells}"
                    ToolTip.Tip="Delete (Del)">
                <Path Data="{StaticResource DeleteIcon}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
            </Button>
        </StackPanel>
    </Border>

</UserControl>
