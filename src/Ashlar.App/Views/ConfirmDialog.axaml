<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ashlar.App.Views.ConfirmDialog"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="12" Spacing="12">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="ConfirmButton" IsDefault="True" Click="OnConfirmClick" MinWidth="80" />
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
