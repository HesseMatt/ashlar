<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ashlar.App.Views.UnsavedChangesDialog"
        Title="Unsaved changes"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <StackPanel Margin="12" Spacing="12">
        <TextBlock Text="The current tileset has changes that were not saved as a project. Save them before continuing?"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Click="OnSaveClick" MinWidth="80" />
            <Button Content="Discard" Click="OnDiscardClick" MinWidth="80" />
            <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
