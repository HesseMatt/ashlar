<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ashlar.App.ViewModels"
        xmlns:views="using:Ashlar.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="650"
        x:Class="Ashlar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ashlar-icon.ico"
        Title="Ashlar"
        Width="1150" Height="650"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:TilesetEditorViewModel">
            <views:TilesetToolBar />
        </DataTemplate>
        <DataTemplate DataType="vm:MapEditorViewModel">
            <views:MapToolBar />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New project" Click="OnNewProjectClick" InputGesture="Ctrl+N" />
                <MenuItem Header="Open project..." Click="OnOpenProjectClick" InputGesture="Ctrl+Shift+O" />
                <MenuItem Header="Open tileset..." Click="OnOpenTilesetClick" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+E" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding Editor.HasImage}" />
                <MenuItem Header="Save project" Click="OnSaveProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save project as..." Click="OnSaveProjectAsClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Close project" Click="OnCloseProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Click="OnUndoClick" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Click="OnRedoClick" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Change tile size..." Click="OnChangeTileSizeClick"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <Separator />
                <MenuItem Header="Delete" Click="OnDeleteSelectedTilesClick" InputGesture="Delete"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasSelectedTiles" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <Separator />
                <MenuItem Header="Rectangle selection" ToggleType="CheckBox" IsChecked="{Binding Editor.IsRectangleToolActive}" InputGesture="Ctrl+R"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Move" ToggleType="CheckBox" IsChecked="{Binding Editor.IsMoveToolActive}" InputGesture="M"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Draw" ToggleType="CheckBox" IsChecked="{Binding Editor.IsDrawToolActive}" InputGesture="B"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Bucket" ToggleType="CheckBox" IsChecked="{Binding Editor.IsBucketToolActive}" InputGesture="G"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Pipette" ToggleType="CheckBox" IsChecked="{Binding Editor.IsPipetteToolActive}" InputGesture="I"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInClick" InputGesture="Ctrl+OemPlus"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Zoom Out" Click="OnZoomOutClick" InputGesture="Ctrl+OemMinus"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
                <MenuItem Header="Reset Zoom" Click="OnResetZoomClick" InputGesture="Ctrl+D0"><MenuItem.IsEnabled><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsTilesetsTabActive" /><Binding Path="Editor.HasImage" /></MultiBinding></MenuItem.IsEnabled></MenuItem>
            </MenuItem>
        </Menu>

        <Border Classes="panelHeader" DockPanel.Dock="Bottom" Margin="0" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="TilesetStatusText" Classes="secondary" Text="{Binding Editor.StatusMessage}" IsVisible="{Binding IsTilesetsTabActive}" />
                <TextBlock x:Name="MapStatusText" Classes="secondary" Text="{Binding MapEditor.StatusMessage}" IsVisible="{Binding !IsTilesetsTabActive}" />
                <TextBlock Classes="secondary" Text="{Binding Editor.ZoomPercentageText}" IsVisible="{Binding Editor.HasImage}" />
                <TextBlock Classes="secondary" Text="{Binding Editor.TileSizeText}" IsVisible="{Binding Editor.HasImage}" />
            </StackPanel>
        </Border>

        <Border x:Name="TilesetListPanel" Classes="panelHeader" DockPanel.Dock="Left" Width="200" Margin="0" BorderThickness="0,0,1,0"
                Padding="8" IsVisible="{Binding IsProjectOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tilesets" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
                    <TextBox x:Name="TilesetNameBox" PlaceholderText="Tileset name" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="RenameTilesetButton" Content="Rename" Click="OnRenameTilesetClick" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="RemoveTilesetButton" Content="Remove" Click="OnRemoveTilesetClick" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="AddTilesetButton" Content="Add tileset..." Click="OnOpenTilesetClick" />
                </StackPanel>
                <ListBox x:Name="TilesetList" ItemsSource="{Binding TilesetNames}" SelectedItem="{Binding SelectedTilesetName, Mode=OneWay}"
                         SelectionChanged="OnTilesetSelectionChanged" />
            </DockPanel>
        </Border>

        <ContentControl x:Name="ToolBarHost" DockPanel.Dock="Left" VerticalAlignment="Top" Content="{Binding ActiveToolBar}" />

        <TabControl x:Name="EditorTabs" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem x:Name="TilesetsTab" Header="Tilesets">
                <Panel>
                    <views:TilesetEditorView x:Name="EditorView" DataContext="{Binding Editor}" />
                    <Border x:Name="EmptyProjectPanel" Classes="canvas" Margin="6" IsVisible="{Binding IsProjectEmpty}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <TextBlock Text="This project has no tileset yet" FontSize="18" HorizontalAlignment="Center" />
                            <Button x:Name="ImportTilesetButton" Content="Import tileset image..." Click="OnOpenTilesetClick" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </TabItem>
            <TabItem x:Name="MapsTab" Header="Maps">
                <views:MapEditorView x:Name="MapView" DataContext="{Binding MapEditor}" />
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
