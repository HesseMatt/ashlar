<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ashlar.App.ViewModels"
        xmlns:views="using:Ashlar.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="650"
        x:Class="Ashlar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ashlar-icon.ico"
        Title="Ashlar"
        Width="1150" Height="650"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New project" Click="OnNewProjectClick" InputGesture="Ctrl+N" />
                <MenuItem Header="Open project..." Click="OnOpenProjectClick" InputGesture="Ctrl+Shift+O" />
                <MenuItem Header="Open tileset..." Click="OnOpenTilesetClick" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+E" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding Editor.HasImage}" />
                <MenuItem Header="Save project" Click="OnSaveProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save project as..." Click="OnSaveProjectAsClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Close project" Click="OnCloseProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Click="OnUndoClick" IsEnabled="{Binding Editor.CanUndo}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Click="OnRedoClick" IsEnabled="{Binding Editor.CanRedo}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Change tile size..." Click="OnChangeTileSizeClick" IsEnabled="{Binding Editor.HasImage}" />
                <Separator />
                <MenuItem Header="Delete" Click="OnDeleteSelectedTilesClick" IsEnabled="{Binding Editor.HasSelectedTiles}" InputGesture="Delete" />
                <Separator />
                <MenuItem Header="Rectangle selection" ToggleType="CheckBox" IsChecked="{Binding Editor.IsRectangleToolActive}"
                          IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+R" />
                <MenuItem Header="Move" ToggleType="CheckBox" IsChecked="{Binding Editor.IsMoveToolActive}"
                          IsEnabled="{Binding Editor.HasImage}" InputGesture="M" />
                <MenuItem Header="Draw" ToggleType="CheckBox" IsChecked="{Binding Editor.IsDrawToolActive}"
                          IsEnabled="{Binding Editor.HasImage}" InputGesture="B" />
                <MenuItem Header="Bucket" ToggleType="CheckBox" IsChecked="{Binding Editor.IsBucketToolActive}"
                          IsEnabled="{Binding Editor.HasImage}" InputGesture="G" />
                <MenuItem Header="Pipette" ToggleType="CheckBox" IsChecked="{Binding Editor.IsPipetteToolActive}"
                          IsEnabled="{Binding Editor.HasImage}" InputGesture="I" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInClick" IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+OemPlus" />
                <MenuItem Header="Zoom Out" Click="OnZoomOutClick" IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+OemMinus" />
                <MenuItem Header="Reset Zoom" Click="OnResetZoomClick" IsEnabled="{Binding Editor.HasImage}" InputGesture="Ctrl+D0" />
            </MenuItem>
        </Menu>

        <Border Classes="panelHeader" DockPanel.Dock="Bottom" Margin="0" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="secondary" Text="{Binding Editor.StatusMessage}" />
                <TextBlock Classes="secondary" Text="{Binding Editor.ZoomPercentageText}" IsVisible="{Binding Editor.HasImage}" />
                <TextBlock Classes="secondary" Text="{Binding Editor.TileSizeText}" IsVisible="{Binding Editor.HasImage}" />
            </StackPanel>
        </Border>

        <Border x:Name="TilesetListPanel" Classes="panelHeader" DockPanel.Dock="Left" Width="200" Margin="0" BorderThickness="0,0,1,0"
                Padding="8" IsVisible="{Binding IsProjectOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tilesets" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
                    <TextBox x:Name="TilesetNameBox" PlaceholderText="Tileset name" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="RenameTilesetButton" Content="Rename" Click="OnRenameTilesetClick" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="RemoveTilesetButton" Content="Remove" Click="OnRemoveTilesetClick" IsEnabled="{Binding HasTilesets}" />
                    <Button x:Name="AddTilesetButton" Content="Add tileset..." Click="OnOpenTilesetClick" />
                </StackPanel>
                <ListBox x:Name="TilesetList" ItemsSource="{Binding TilesetNames}" SelectedItem="{Binding SelectedTilesetName, Mode=OneWay}"
                         SelectionChanged="OnTilesetSelectionChanged" />
            </DockPanel>
        </Border>

        <Panel>
            <views:TilesetEditorView x:Name="EditorView" DataContext="{Binding Editor}" />
            <Border x:Name="EmptyProjectPanel" Classes="canvas" Margin="6" IsVisible="{Binding IsProjectEmpty}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="This project has no tileset yet" FontSize="18" HorizontalAlignment="Center" />
                    <Button x:Name="ImportTilesetButton" Content="Import tileset image..." Click="OnOpenTilesetClick" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>

</Window>
