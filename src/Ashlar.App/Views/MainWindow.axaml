<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ashlar.App.ViewModels"
        xmlns:views="using:Ashlar.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="650"
        x:Class="Ashlar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ashlar-icon.ico"
        Title="Ashlar"
        Width="1150" Height="650"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Icon paths are from Lucide (https://lucide.dev), 24x24 viewBox, stroked. See NOTICE. -->
        <StreamGeometry x:Key="FilePlusIcon">M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M9 15h6 M12 18v-6</StreamGeometry>
        <StreamGeometry x:Key="FolderOpenIcon">m6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2</StreamGeometry>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:TilesetEditorViewModel">
            <views:TilesetToolBar />
        </DataTemplate>
        <DataTemplate DataType="vm:MapEditorViewModel">
            <views:MapToolBar />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New project" Click="OnNewProjectClick" InputGesture="Ctrl+N" />
                <MenuItem Header="Open project..." Click="OnOpenProjectClick" InputGesture="Ctrl+Shift+O" />
                <MenuItem Header="Open tileset..." Click="OnOpenTilesetClick" InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" IsEnabled="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Export map..." Click="OnExportMapClick" IsEnabled="{Binding HasSelectedMap}" />
                <MenuItem Header="Save project" Click="OnSaveProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save project as..." Click="OnSaveProjectAsClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="Close tab" Click="OnCloseTabClick" IsEnabled="{Binding HasOpenTabs}" InputGesture="Ctrl+W" />
                <MenuItem Header="Close project" Click="OnCloseProjectClick" IsEnabled="{Binding IsProjectOpen}" InputGesture="Ctrl+Shift+W" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Click="OnUndoClick" IsEnabled="{Binding ActiveTab.CanUndo, FallbackValue=False}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Click="OnRedoClick" IsEnabled="{Binding ActiveTab.CanRedo, FallbackValue=False}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Delete" Click="OnDeleteSelectedTilesClick" InputGesture="Delete"
                          IsVisible="{Binding IsTilesetTabActive}" IsEnabled="{Binding ActiveTileset.HasSelectedTiles, FallbackValue=False}" />
                <MenuItem Header="Delete" Click="OnDeleteSelectedCellsClick" InputGesture="Delete"
                          IsVisible="{Binding IsMapTabActive}" IsEnabled="{Binding ActiveMap.HasSelectedCells, FallbackValue=False}" />
                <Separator />
                <MenuItem Header="Rectangle selection" ToggleType="CheckBox" IsChecked="{Binding ActiveTileset.IsRectangleToolActive}" InputGesture="Ctrl+R" IsVisible="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Move" ToggleType="CheckBox" IsChecked="{Binding ActiveTileset.IsMoveToolActive}" InputGesture="M" IsVisible="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Draw" ToggleType="CheckBox" IsChecked="{Binding ActiveTileset.IsDrawToolActive}" InputGesture="B" IsVisible="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Bucket" ToggleType="CheckBox" IsChecked="{Binding ActiveTileset.IsBucketToolActive}" InputGesture="G" IsVisible="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Pipette" ToggleType="CheckBox" IsChecked="{Binding ActiveTileset.IsPipetteToolActive}" InputGesture="I" IsVisible="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Rectangle selection" ToggleType="CheckBox" IsChecked="{Binding ActiveMap.IsRectangleToolActive}" IsVisible="{Binding IsMapTabActive}" />
                <MenuItem Header="Move" ToggleType="CheckBox" IsChecked="{Binding ActiveMap.IsMoveToolActive}" IsVisible="{Binding IsMapTabActive}" />
                <MenuItem Header="Draw" ToggleType="CheckBox" IsChecked="{Binding ActiveMap.IsDrawToolActive}" IsVisible="{Binding IsMapTabActive}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInClick" InputGesture="Ctrl+OemPlus" IsEnabled="{Binding HasOpenTabs}" />
                <MenuItem Header="Zoom Out" Click="OnZoomOutClick" InputGesture="Ctrl+OemMinus" IsEnabled="{Binding HasOpenTabs}" />
                <MenuItem Header="Reset Zoom" Click="OnResetZoomClick" InputGesture="Ctrl+D0" IsEnabled="{Binding HasOpenTabs}" />
            </MenuItem>
            <MenuItem Header="_Tileset">
                <MenuItem Header="Add tileset..." Click="OnOpenTilesetClick" />
                <MenuItem Header="Rename" Click="OnRenameSelectedTilesetClick" InputGesture="F2" IsEnabled="{Binding HasSelectedTileset}" />
                <MenuItem Header="Remove" Click="OnRemoveSelectedTilesetClick" IsEnabled="{Binding HasSelectedTileset}" />
                <MenuItem Header="Change tile size..." Click="OnChangeTileSizeClick" IsEnabled="{Binding IsTilesetTabActive}" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" InputGesture="Ctrl+E" IsEnabled="{Binding IsTilesetTabActive}" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding IsTilesetTabActive}" />
            </MenuItem>
            <MenuItem Header="_Map">
                <MenuItem Header="Create map..." Click="OnCreateMapClick" IsEnabled="{Binding CanCreateMap}" />
                <MenuItem Header="Rename" Click="OnRenameSelectedMapClick" InputGesture="F2" IsEnabled="{Binding HasSelectedMap}" />
                <MenuItem Header="Resize..." Click="OnResizeSelectedMapClick" IsEnabled="{Binding HasSelectedMap}" />
                <MenuItem Header="Delete" Click="OnDeleteSelectedMapClick" IsEnabled="{Binding HasSelectedMap}" />
                <Separator />
                <MenuItem Header="Export map..." Click="OnExportMapClick" InputGesture="Ctrl+E" IsEnabled="{Binding HasSelectedMap}" />
            </MenuItem>
        </Menu>

        <Border Classes="panelHeader" DockPanel.Dock="Bottom" Margin="0" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="StatusText" Classes="secondary" Text="{Binding StatusText}" />
                <TextBlock Classes="secondary" Text="{Binding ActiveTileset.ZoomPercentageText}" IsVisible="{Binding IsTilesetTabActive}" />
                <TextBlock Classes="secondary" Text="{Binding ActiveTileset.TileSizeText}" IsVisible="{Binding IsTilesetTabActive}" />
                <TextBlock Classes="secondary" Text="{Binding ActiveMap.ZoomPercentageText}" IsVisible="{Binding IsMapTabActive}" />
            </StackPanel>
        </Border>

        <Border x:Name="ExplorerPanel" Classes="panelHeader" DockPanel.Dock="Left" Width="200" Margin="0" BorderThickness="0,0,1,0"
                Padding="8" IsVisible="{Binding IsProjectOpen}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Project" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TreeView x:Name="ExplorerTree" ItemsSource="{Binding ExplorerRoots}" SelectedItem="{Binding ExplorerSelection}"
                          DoubleTapped="OnExplorerDoubleTapped" KeyDown="OnExplorerKeyDown">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="vm:ExplorerNode" ItemsSource="{Binding Children}">
                            <Panel Background="Transparent" DataContextChanged="OnExplorerEntryDataContextChanged">
                                <TextBlock Text="{Binding Name}" IsVisible="{Binding IsGroup}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsGroup" />
                                            <Binding Path="!IsRenaming" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextBox Text="{Binding RenameText, Mode=TwoWay}" IsVisible="{Binding IsRenaming}" MinHeight="0" Padding="4,2"
                                         KeyDown="OnRenameBoxKeyDown" LostFocus="OnRenameBoxLostFocus"
                                         PropertyChanged="OnRenameBoxPropertyChanged" />
                            </Panel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ToolBarHost" DockPanel.Dock="Left" VerticalAlignment="Top" Content="{Binding ActiveTab}" />

        <DockPanel>
            <TabStrip x:Name="EditorTabs" DockPanel.Dock="Top" ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveTab}"
                      IsVisible="{Binding HasOpenTabs}">
                <TabStrip.Styles>
                    <Style Selector="TabStripItem">
                        <Setter Property="MinHeight" Value="26" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </TabStrip.Styles>
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="vm:EditorTabViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent" PointerReleased="OnTabHeaderPointerReleased">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Content="x" Padding="4,0" FontSize="12" MinHeight="0" MinWidth="0" Background="Transparent" Click="OnTabCloseClick"
                                    ToolTip.Tip="Close tab" />
                        </StackPanel>
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>

            <Panel>
                <!-- Every open tab keeps its own live view so its scroll position survives switching; only the active one is shown. -->
                <ItemsControl x:Name="EditorHost" ItemsSource="{Binding OpenTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Panel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Styles>
                        <Style Selector="ItemsControl#EditorHost > ContentPresenter">
                            <Setter Property="IsVisible" Value="{ReflectionBinding IsActive}" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:TilesetEditorViewModel">
                            <views:TilesetEditorView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:MapEditorViewModel">
                            <views:MapEditorView />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>

                <Border x:Name="EmptyEditorPanel" Classes="canvas" Margin="6" IsVisible="{Binding !HasOpenTabs}">
                    <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding !IsProjectOpen}">
                            <Button x:Name="NewProjectPanel" Classes="startPanel" Click="OnNewProjectClick">
                                <StackPanel Spacing="12">
                                    <Path Data="{StaticResource FilePlusIcon}" />
                                    <TextBlock Text="Create a new project" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenProjectPanel" Classes="startPanel" Click="OnOpenProjectClick">
                                <StackPanel Spacing="12">
                                    <Path Data="{StaticResource FolderOpenIcon}" />
                                    <TextBlock Text="Open existing project" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel x:Name="ProjectHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding IsProjectOpen}">
                            <TextBlock x:Name="EmptyEditorText" Text="{Binding EmptyEditorText}" FontSize="18" HorizontalAlignment="Center" />
                            <Button x:Name="ImportTilesetButton" Content="Import tileset image..." Click="OnOpenTilesetClick" HorizontalAlignment="Center"
                                    IsVisible="{Binding !HasTilesets}" />
                        </StackPanel>
                    </Panel>
                </Border>
            </Panel>
        </DockPanel>
    </DockPanel>

</Window>
