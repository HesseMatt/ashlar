<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TileEdit.App.ViewModels"
        xmlns:controls="using:TileEdit.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="650"
        x:Class="TileEdit.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TileEdit"
        Width="1150" Height="650"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open tileset..." Click="OnOpenTilesetClick" InputGesture="Ctrl+O" />
                <MenuItem Header="Open project..." Click="OnOpenProjectClick" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+E" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save project..." Click="OnSaveProjectClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+Shift+S" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Delete" Click="OnDeleteSelectedTilesClick" IsEnabled="{Binding HasSelectedTiles}" InputGesture="Delete" />
                <MenuItem Header="{Binding MoveButtonLabel}" Click="OnToggleMoveClick" IsEnabled="{Binding CanToggleMove}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+OemPlus" />
                <MenuItem Header="Zoom Out" Click="OnZoomOutClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+OemMinus" />
                <MenuItem Header="Reset Zoom" Click="OnResetZoomClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+D0" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="12">
            <TextBlock Text="Tile width:" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TileWidth}" Minimum="1" Width="100" />
            <TextBlock Text="Tile height:" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TileHeight}" Minimum="1" Width="100" />
            <TextBlock Text="Texture path:" VerticalAlignment="Center" />
            <TextBox Text="{Binding TexturePath}" Width="160" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="12,0,12,12">
            <TextBlock Text="{Binding StatusMessage}" />
            <TextBlock Text="{Binding ZoomPercentageText}" IsVisible="{Binding HasImage}" />
        </StackPanel>

        <Border DockPanel.Dock="Right" Width="220" Margin="0,0,12,12" Padding="12"
                BorderBrush="Gray" BorderThickness="1">
            <StackPanel Spacing="16">
                <TextBlock Text="Inspector" FontWeight="Bold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Tile ID" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTileId}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Group" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding GroupNames}" IsEditable="True" Text="{Binding GroupNameInput, Mode=TwoWay}"
                              IsEnabled="{Binding HasSelectedTiles}" HorizontalAlignment="Stretch"
                              KeyDown="OnGroupNameInputKeyDown" SelectionChanged="OnGroupNameSelectionChanged" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="TileCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="12,0,12,12">
            <Panel Width="{Binding ScaledImageWidth}" Height="{Binding ScaledImageHeight}" IsVisible="{Binding HasImage}"
                   Focusable="True" PointerPressed="OnTileCanvasPointerPressed" PointerMoved="OnTileCanvasPointerMoved"
                   PointerReleased="OnTileCanvasPointerReleased" PointerCaptureLost="OnTileCanvasPointerCaptureLost"
                   PointerWheelChanged="OnTileCanvasPointerWheelChanged">
                <!-- Left/Top alignment is load-bearing: a Panel centers a child that has an
                     explicit Width/Height, which would place this panel's unscaled layout slot
                     in the middle of the zoomed wrapper above. The ScaleTransform then scales
                     out from there instead of from the wrapper's origin, pushing the right and
                     bottom of the image outside the scrollable extent, where it can't be
                     reached by panning. -->
                <Panel x:Name="TileCanvasContent" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                    <Panel.RenderTransform>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                    </Panel.RenderTransform>
                    <Image Source="{Binding PreviewBitmap}" Stretch="None" />
                    <controls:TileGridOverlay ImageWidth="{Binding ImageWidth}" ImageHeight="{Binding ImageHeight}"
                                               TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}"
                                               SelectedTiles="{Binding SelectedTiles}" />
                </Panel>
            </Panel>
        </ScrollViewer>
    </DockPanel>

</Window>
