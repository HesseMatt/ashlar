<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TileEdit.App.ViewModels"
        xmlns:controls="using:TileEdit.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="650"
        x:Class="TileEdit.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TileEdit"
        Width="1150" Height="650"
        KeyDown="OnWindowKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Icon paths are from Lucide (https://lucide.dev), 24x24 viewBox, stroked. See NOTICE. -->
        <StreamGeometry x:Key="RectangleSelectIcon">M12.034 12.681a.498.498 0 0 1 .647-.647l9 3.5a.5.5 0 0 1-.033.943l-3.444 1.068a1 1 0 0 0-.66.66l-1.067 3.443a.5.5 0 0 1-.943.033z M5 3a2 2 0 0 0-2 2 M19 3a2 2 0 0 1 2 2 M5 21a2 2 0 0 1-2-2 M9 3h1 M9 21h2 M14 3h1 M3 9v1 M21 9v2 M3 14v1</StreamGeometry>
        <StreamGeometry x:Key="MoveIcon">M12 2v20 m15 19-3 3-3-3 m19 9 3 3-3 3 M2 12h20 m5 9-3 3 3 3 m9 5 3-3 3 3</StreamGeometry>
        <StreamGeometry x:Key="DrawIcon">M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z m15 5 4 4</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M3 6h18 M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6 M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2 M10 11v6 M14 11v6</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.panel Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open tileset..." Click="OnOpenTilesetClick" InputGesture="Ctrl+O" />
                <MenuItem Header="Open project..." Click="OnOpenProjectClick" InputGesture="Ctrl+Shift+O" />
                <Separator />
                <MenuItem Header="Export XML..." Click="OnExportXmlClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+E" />
                <MenuItem Header="Save image..." Click="OnSaveImageClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+S" />
                <MenuItem Header="Save project..." Click="OnSaveProjectClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+Shift+S" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Click="OnUndoClick" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z" />
                <MenuItem Header="Redo" Click="OnRedoClick" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Delete" Click="OnDeleteSelectedTilesClick" IsEnabled="{Binding HasSelectedTiles}" InputGesture="Delete" />
                <Separator />
                <MenuItem Header="Rectangle selection" ToggleType="CheckBox" IsChecked="{Binding IsRectangleToolActive}"
                          IsEnabled="{Binding HasImage}" InputGesture="Ctrl+R" />
                <MenuItem Header="Move" ToggleType="CheckBox" IsChecked="{Binding IsMoveToolActive}"
                          IsEnabled="{Binding HasImage}" InputGesture="M" />
                <MenuItem Header="Draw" ToggleType="CheckBox" IsChecked="{Binding IsDrawToolActive}"
                          IsEnabled="{Binding HasImage}" InputGesture="B" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In" Click="OnZoomInClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+OemPlus" />
                <MenuItem Header="Zoom Out" Click="OnZoomOutClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+OemMinus" />
                <MenuItem Header="Reset Zoom" Click="OnResetZoomClick" IsEnabled="{Binding HasImage}" InputGesture="Ctrl+D0" />
            </MenuItem>
        </Menu>

        <Border Classes="panel" DockPanel.Dock="Top" Margin="6,6,6,0" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Tile width:" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding TileWidth}" Minimum="1" Width="130" IsEnabled="{Binding CanEditTileSize}" />
                <TextBlock Text="Tile height:" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding TileHeight}" Minimum="1" Width="130" IsEnabled="{Binding CanEditTileSize}" />
                <TextBlock Text="Draw color:" VerticalAlignment="Center" />
                <ColorPicker x:Name="DrawColorPicker" Color="{Binding DrawColor}" IsAlphaEnabled="True" IsEnabled="{Binding HasImage}" />
            </StackPanel>
        </Border>

        <Border Classes="panelHeader" DockPanel.Dock="Bottom" Margin="0" BorderThickness="0,1,0,0" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="secondary" Text="{Binding StatusMessage}" />
                <TextBlock Classes="secondary" Text="{Binding ZoomPercentageText}" IsVisible="{Binding HasImage}" />
            </StackPanel>
        </Border>

        <Border Classes="panel" DockPanel.Dock="Right" Width="220" Margin="0,6,6,6" ClipToBounds="True">
            <DockPanel>
                <Border Classes="panelHeader" DockPanel.Dock="Top">
                    <TextBlock Classes="panelHeaderText" Text="INSPECTOR" />
                </Border>
                <StackPanel Spacing="16" Margin="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" Text="Tile ID" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedTileId}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="secondary" Text="Group" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding GroupNames}" IsEditable="True" Text="{Binding GroupNameInput, Mode=TwoWay}"
                                  IsEnabled="{Binding HasSelectedTiles}" HorizontalAlignment="Stretch"
                                  KeyDown="OnGroupNameInputKeyDown" SelectionChanged="OnGroupNameSelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Classes="panel" DockPanel.Dock="Left" Margin="6,6,0,6" Padding="4" VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <ToggleButton Classes="tool" x:Name="RectangleSelectButton" IsChecked="{Binding IsRectangleToolActive}" IsEnabled="{Binding HasImage}"
                              ToolTip.Tip="Rectangle select (Ctrl+R)">
                    <Path Data="{StaticResource RectangleSelectIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
                </ToggleButton>
                <ToggleButton Classes="tool" x:Name="MoveButton" IsChecked="{Binding IsMoveToolActive}" IsEnabled="{Binding HasImage}"
                              ToolTip.Tip="Move (M)">
                    <Path Data="{StaticResource MoveIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
                </ToggleButton>
                <ToggleButton Classes="tool" x:Name="DrawButton" IsChecked="{Binding IsDrawToolActive}" IsEnabled="{Binding HasImage}"
                              ToolTip.Tip="Draw (B)">
                    <Path Data="{StaticResource DrawIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
                </ToggleButton>
                <Button Classes="tool" x:Name="DeleteButton" Click="OnDeleteSelectedTilesClick" IsEnabled="{Binding HasSelectedTiles}"
                        ToolTip.Tip="Delete (Del)">
                    <Path Data="{StaticResource DeleteIcon}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
                </Button>
            </StackPanel>
        </Border>

        <Border Classes="canvas" Margin="6">
            <ScrollViewer x:Name="TileCanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- The padding is the overscroll margin around the zoomed tileset (set from code,
                     since it depends on the viewport size). The transparent background makes the
                     padding hit-testable, so panning can start there too. -->
                <Border x:Name="TileCanvasPadding" Background="Transparent" IsVisible="{Binding HasImage}"
                        Focusable="True" PointerPressed="OnTileCanvasPointerPressed" PointerMoved="OnTileCanvasPointerMoved"
                        PointerReleased="OnTileCanvasPointerReleased" PointerCaptureLost="OnTileCanvasPointerCaptureLost"
                        PointerWheelChanged="OnTileCanvasPointerWheelChanged">
                    <Panel Width="{Binding ScaledImageWidth}" Height="{Binding ScaledImageHeight}">
                        <!-- Left/Top alignment is load-bearing: a Panel centers a child that has an
                             explicit Width/Height, which would place this panel's unscaled layout slot
                             in the middle of the zoomed wrapper above. The ScaleTransform then scales
                             out from there instead of from the wrapper's origin, pushing the right and
                             bottom of the image outside the scrollable extent, where it can't be
                             reached by panning. -->
                        <Panel x:Name="TileCanvasContent" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                            <Panel.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                            </Panel.RenderTransform>
                            <controls:TransparencyCheckerboard ImageWidth="{Binding ImageWidth}" ImageHeight="{Binding ImageHeight}"
                                                               TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}" />
                            <Image x:Name="TilesetImage" Source="{Binding PreviewBitmap}" Stretch="None" />
                            <controls:TileGridOverlay x:Name="TileOverlay" ImageWidth="{Binding ImageWidth}" ImageHeight="{Binding ImageHeight}"
                                                       TileWidth="{Binding TileWidth}" TileHeight="{Binding TileHeight}"
                                                       SelectedTiles="{Binding SelectedTiles}"
                                                       SelectionRectangle="{Binding SelectionRectangle}"
                                                       MoveOffset="{Binding MoveOffset}" Image="{Binding PreviewBitmap}"
                                                       ZoomLevel="{Binding ZoomLevel}" ShowPixelGrid="{Binding ShowPixelGrid}" />
                        </Panel>
                    </Panel>
                </Border>
            </ScrollViewer>
        </Border>
    </DockPanel>

</Window>
